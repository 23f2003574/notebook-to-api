# Build-time settings for the dashboard frontend (Vite inlines VITE_* at `vite` / `vite build`).
# Copy to .env.local and edit. Everything VITE_-prefixed is public in the built bundle:
# never put a server secret here.

# Dashboard backend (upload, inspect, compile): an absolute http(s) URL, optionally with a base
# path, or a path on the page's own origin such as /dashboard. Anything else is rejected.
# Unset: http://localhost:8001 under `vite` (development); the page's own origin in a production
# build, which is how `python -m backend.dashboard` serves a built frontend.
# VITE_DASHBOARD_API_URL=https://dashboard.example.com

# Compiled application the endpoint tester calls, and its /docs link. Unset: http://localhost:8000
# under `vite`; REQUIRED in a production build (there is no same-origin equivalent).
# VITE_APP_URL=https://api.example.com

# Sent as X-API-Key to the dashboard backend when it runs with NOTEBOOK_API_DASHBOARD_KEY.
# This value is visible to anyone who can load the dashboard.
# VITE_DASHBOARD_API_KEY=
